DATABASE_URL="postgresql://user:password@localhost:5432/giacasa?schema=public"

# NextAuth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Twilio Verify (OTP). Console -> Account -> API keys & tokens, and a Verify
# Service SID from Verify -> Services. Without these, OTP falls back to a
# dev-mode stub that logs the code server-side instead of sending an SMS.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""

# Stripe (test mode). https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Stripe test-mode price IDs for the 3 paid seller plans. See scripts/stripe-setup.md.
STRIPE_PRICE_VISIBILITY_BOOST=""
STRIPE_PRICE_SMART_AGENT=""
STRIPE_PRICE_CONCIERGE_LUXURY=""
